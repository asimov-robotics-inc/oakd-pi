[Unit]
Description=OAK-D Egocentric Data Capture
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/oakd-pi
ExecStart=/home/pi/.local/bin/uv run python -m oakd_capture
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Graceful shutdown
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
