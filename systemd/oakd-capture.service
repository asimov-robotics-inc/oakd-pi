[Unit]
Description=OAK-D Egocentric Data Capture
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/oakd-pi
ExecStart=/home/pi/oakd-pi/.venv/bin/python -m oakd_capture
Restart=always
RestartSec=5
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal

# Graceful shutdown — app exits fast, no need for a long timeout
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
